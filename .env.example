# ═══════════════════════════════════════════════════════════════════
#  CloudVault Gateway — Environment Configuration Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ─── Server ─────────────────────────────────────────────────────────
PORT=3000

# ─── Security ───────────────────────────────────────────────────────
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Optional: if set, POST /api/v1/auth/token requires this key in x-api-key header
TOKEN_API_KEY=

# Set to true ONLY in local development/CI. Never in production.
# DISABLE_AUTH=false

# ─── MySQL ──────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cloudvault
MYSQL_PASSWORD=
MYSQL_DATABASE=cloudvault

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Local Cache Storage ────────────────────────────────────────────
TENANTS_STORAGE_DIR=./storage/tenants
LOCAL_BLOCKS_DIR=./storage/blocks

# Maximum local SSD cache size before LRU eviction kicks in (bytes)
# Default: 104857600 = 100 MB
MAX_CACHE_SIZE_BYTES=104857600

# Maximum allowed upload size per request (bytes). 0 = no limit.
# Example: 524288000 = 500 MB
MAX_UPLOAD_SIZE_BYTES=0

# ─── AWS Core ───────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Leave blank when running on EC2 / ECS / Lambda with an IAM role attached.
# The SDK will pick up credentials automatically via the instance profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# For temporary STS / assumed-role credentials only
# AWS_SESSION_TOKEN=

# ─── S3 Buckets ─────────────────────────────────────────────────────
# Hot bucket: active files, frequent access (S3 Standard)
HOT_BUCKET=cloudvault-hot-standard
S3_BUCKET_NAME=cloudvault-hot-standard   # alias used by some internals

# Cold bucket: archived files, Glacier storage class
COLD_BUCKET=cloudvault-cold-glacier

# How many days of inactivity before a file is tiered to Glacier
TIERING_INACTIVITY_DAYS=30

# Enable per-tenant bucket routing (each tenant gets its own S3 bucket prefix)
# DYNAMIC_TENANT_BUCKETS=false

# ─── Local S3-Compatible Endpoint (optional) ────────────────────────
# Use for local development with LocalStack or MinIO instead of real AWS.
# Comment out or leave blank to use real AWS S3.
# S3_ENDPOINT=http://localhost:4566

# ─── AWS Secrets Manager (optional) ────────────────────────────────
# If set, CloudVault fetches credentials from Secrets Manager on startup,
# overriding the env vars above. Recommended for production.
# The secret must be a JSON object — see secretsService.js for expected keys.
# SECRETS_MANAGER_NAME=cloudvault/production/secrets

# ─── SNS / SQS Event Notifications (optional) ──────────────────────
# If set, CloudVault listens for S3 change events via SQS long-polling
# and automatically invalidates local cache when files change in S3.
# AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/cloudvault-events

# SNS topic ARN (used if you want CloudVault to publish events)
# AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:cloudvault-notifications

# ─── AWS Lambda (optional) ──────────────────────────────────────────
# Used when deploying the Intelligent Tiering job as an AWS Lambda function.
# LAMBDA_FUNCTION_NAME=CloudVault-Intelligent-Tiering
# EVENTBRIDGE_RULE_ARN=arn:aws:events:us-east-1:ACCOUNT_ID:rule/cloudvault-nightly-tiering
